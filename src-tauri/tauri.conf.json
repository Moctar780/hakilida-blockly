{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-v2-schema/refs/heads/main/tauri.conf.json",
  "productName": "Starter Kit Racing",
  "version": "0.1.0",
  "identifier": "com.starter-kit-racing.game",
  "build": {
    "frontendDist": "../www",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "python3 -m http.server 8080",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Starter Kit Racing",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
